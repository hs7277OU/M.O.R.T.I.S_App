# MORTIS - example environment file
#
# Copy this file to ".env" in the project root and fill in your own values:
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env is listed in .gitignore, so your real keys are never committed.
# Every value below is optional - the app runs without a .env file.


# --- Executive summary (optional) --------------------------------------------
# Anthropic API key. When set, scan reports include an AI-generated executive
# summary. Without it MORTIS falls back to a built-in offline summary, so the
# scanner still works fully. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for the summary (default: claude-sonnet-5)
# MORTIS_LLM_MODEL=claude-sonnet-5

# Max tokens for the summary (defaults: 2000 basic, 4000 technical)
# MORTIS_LLM_MAX_TOKENS=2000


# --- Flask / app settings (optional) -----------------------------------------
# Session signing key. If unset, a random key is generated at startup, which
# means logins are dropped every time the app restarts. Set a long random
# string for anything beyond local testing.
# SECRET_KEY=

# Password for the default "admin" account, applied only when the database is
# first created (default: mortis123). Change this before any real deployment.
# MORTIS_ADMIN_PW=

# Set to 1 to run Flask in debug mode. Leave unset in production.
# FLASK_DEBUG=0


# --- Scanner tuning (optional) -----------------------------------------------
# Delay in seconds between requests sent to the target, to stay polite and
# avoid tripping rate limits (default: 0.3)
# MORTIS_DELAY=0.3
