# =============================================================================
# M.O.R.T.I.S environment variables
# -----------------------------------------------------------------------------
# Rename this file from "env.example" to ".env", then fill in your values:
#
#   cp env.example .env         (macOS / Linux)
#   copy env.example .env       (Windows)
#
# The real .env file is git-ignored, so your secrets are never committed.
# =============================================================================

# To enable AI summaries, add your own Anthropic API key below,
# then save this file as ".env" (get a key from https://console.anthropic.com/).

ANTHROPIC_API_KEY=
